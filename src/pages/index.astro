  'fossil': '<path d="M159.9 19.55c-20.7.2-41.7 7.8-60.4 20.8c-53.2 37-89.8 119.45-56.7 216.85c14 41.3 17.2 76.3 12.5 102.9c-4.6 26.5-16.6 44.3-33.4 53.5l9 16.4c22.5-12.3 37.5-36 42.8-66.7c5.4-30.7 1.6-68.6-13.2-112.1c-30.7-90.4 3.9-163.55 49.7-195.45c22.9-16 48.2-21.4 69.9-14.6c8.8 2.7 17.2 7.5 24.9 14.6c6.8-1.9 13.9-3.4 21-4.5c-11.5-14-25.3-23.3-40.4-28c-9.2-2.48-17.2-3.7-25.7-3.7m166.5 3.8c-14.9 4.6-28.5 13.7-40 27.4q10.95 1.5 21.6 4.2c7.4-6.7 15.5-11.2 24-13.8c21.7-6.8 46.9-1.4 69.8 14.6c45.8 31.9 80.5 105.05 49.7 195.45c-14.7 43.5-18.6 81.4-13.2 112.1s20.4 54.4 42.8 66.7l9-16.4c-16.7-9.2-28.8-27-33.4-53.5c-4.6-26.6-1.5-61.6 12.5-102.9c33.1-97.4-3.5-179.75-56.7-216.85c-18.7-13-39.7-20.6-60.3-20.8c-8.9.1-18.5 1.48-25.8 3.8M258 67.45c-45.6 0-86 15.3-115.4 46.25c-18.4 19.4-32.6 45.3-40.6 78.1c25.2-18.3 62.6-29.2 87.9-33.8c3-.4 4.9-.3 7.4 1.1c40.3 20.3 84.2 21.5 121.7 0c2.4-1.8 3.6-1.6 6.4-1.1c35.8 5 64.1 15.1 88.5 33.4c-8.1-32.6-22.2-58.3-40.6-77.7C344 82.75 303.5 67.45 258 67.45M190.9 177c-28.4 7.6-94.13 24.2-95.2 57h-.2q-.75 9-.9 18.6c27.9-23.9 64.7-34.3 97.2-40.1c-.5 6.3-.9 12.7-1.3 19.2c-30.8 6.8-92.77 17.3-94.6 56.1v.2c.7 7 1.5 13.8 2.6 20.6c22.9-21.8 63.8-35.3 90.8-40.6c-.2 6.4 0 13.3 0 19.1c-26.5 8.6-82.9 20.6-84.9 50.7c2 7.8 4.3 15.6 6.8 23c18.7-20.2 55.9-32.8 79.3-37.7c.4 6.4.8 12.7 1.3 18.9c-24.7 5.7-66.7 19.4-71.6 41.5c4.2 9.5 8.9 18.5 13.9 26.9c15.2-17.6 42-26.7 61.5-31.3c.8 6.4 1.8 12.5 2.8 18.7c-15.1 5.1-50.3 13.9-52.3 30.7c6.9 9.3 14.4 17.8 22.2 25.3c9.9-10.1 26-15.7 37.8-18.5c1.6 6.3 3.3 12.3 5.2 18c-10.8 3.9-21.6 5.4-28.7 12.5c22.7 17.1 48.3 26.6 75.4 26.6c26.6 0 51.8-9.1 74.3-25.8c-7.6-7.1-20-10.8-28.7-13.1c1.8-5.7 3.6-11.7 5.2-18c12.9 3.3 30.8 10.5 37.8 19.3c8.8-8.2 17-17.7 24.6-28.2c-8.6-18.2-37.1-25.7-54.4-29.5c1-6 2-12.1 2.8-18.6c23.7 5.2 49 13 63 30.7c4.7-8.1 9.1-16.7 13.1-25.7c-6.4-24.2-52.2-37.4-72.2-41.7c.5-6.2.9-12.4 1.3-18.8c27.5 5.7 63.2 18.2 79.9 37.7q3.75-10.8 6.6-22.2c-13.7-27.7-60.3-45.9-85.3-51.2c0-6.8.3-13 0-19.2c34.5 11.7 70 18.2 91.2 42.4c1.2-7.4 2.1-14.9 2.8-22.5c-7.3-35.6-67.6-51.1-95.2-56.4c-.4-6.5-.8-13-1.3-19.2c34.9 7 72.7 16.8 97.8 40.2c-.1-8-.5-15.8-1.2-23.3c-13.5-33.4-66.2-46.7-95-52.2c-44.8 21.5-92.3 22.1-134.2-.1m114 37c.5 6.7 1 13.6 1.4 20.6c-31.3 12.6-68.2 13-97.3.6c.4-6.8.8-13.5 1.4-20.2c28.4 13.4 68.6 14.8 94.5-1m2.5 55.7c0 7.4-.1 15.3-.2 21.8c-31.6 13.2-69.7 13.5-99.1.6c-.1-7.9-.2-13.9-.2-21.2c30.3 15.1 72.2 16.8 99.5-1.2m-1.6 55.3c-.5 7.6-1 15.1-1.7 22.3c-30 11.6-65 11.9-92.9.6c-.7-7-1.2-14.3-1.7-21.7c28.2 14.2 71 15.9 96.3-1.2m-5.7 56.1c-1.1 7.6-2.3 14.8-3.6 21.8c-26.1 7.7-53.6 7.9-77.9.3c-1.2-6.8-2.4-13.9-3.5-21.4c26.7 10.5 60.4 11.6 85-.7M225 432.6c19.5 8.1 46.4 9.7 64.9.1q-3.3 12.3-6.9 22.5c-17.3 3.7-35.1 3.9-51.2-.2c-2.4-6.7-4.6-14.2-6.8-22.4"/>',
};

// Offer icons: Lucide line set (uniform grid + stroke, consistent optical size).
const offerIcons: Record<string, string> = {
  'person-standing': '<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><circle cx="12" cy="5" r="1"/><path d="m9 20l3-6l3 6M6 8l6 2l6-2m-6 2v4"/></g>',
  'handshake': '<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m11 17l2 2a1 1 0 1 0 3-3"/><path d="m14 14l2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"/><path d="m21 3l1 11h-2M3 3L2 14l6.5 6.5a1 1 0 1 0 3-3M3 4h8"/></g>',
  'refresh-cw': '<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="M3 12a9 9 0 0 1 9-9a9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5m5 4a9 9 0 0 1-9 9a9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/></g>',
  'hammer': '<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path d="m15 12l-9.373 9.373a1 1 0 0 1-3.001-3L12 9m6 6l4-4"/><path d="m21.5 11.5l-1.914-1.914A2 2 0 0 1 19 8.172v-.344a2 2 0 0 0-.586-1.414l-1.657-1.657A6 6 0 0 0 12.516 3H9l1.243 1.243A6 6 0 0 1 12 8.485V10l2 2h1.172a2 2 0 0 1 1.414.586L18.5 14.5"/></g>',
};

// Per-icon viewBox for emblems that aren't the default 24x24 grid.
const tileVB: Record<string, string> = {
  'gamepad-2': '0 0 512 512',
  'fossil': '0 0 512 512',
  'hammer': '0 0 576 512',
  'scroll-unfurled': '0 0 512 512',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name} · {profile.role}</title>
    <meta name="description" content={`${profile.name}, ${profile.role}.`} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='23' fill='%2306b6d4'/><text x='50' y='68' font-size='52' font-family='sans-serif' font-weight='700' fill='white' text-anchor='middle'>HC</text></svg>" />
  </head>
  <body>
    <main class="wrap">
      <div class="layout">
        <div class="col-left">
          <section class="cta">
            <div class="cta-line">{cta.line}</div>
          </section>

          <div class="col-main">
          <header class="hero">
            <div class="hero-plate">
              <span class="hero-orn" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 1 15 9 23 12 15 15 12 23 9 15 1 12 9 9Z"/></svg>
              </span>
              <h1 class="hook">{hook.headline}</h1>
            </div>
            <div class="hero-class">
              {hook.tags.map((t) => <span class="hero-tag">{t}</span>)}
            </div>
            <p class="hero-intro" set:html={hook.intro}></p>
            <ul class="hero-flavor">
              {about.map((p) => <li set:html={p}></li>)}
            </ul>
          </header>

          <section>
            <div class="section-title">What I Can Deliver <span class="section-cn">// 我能交付</span></div>
            <div class="offers">
              {offers.map((o) => (
                <div class="offer">
                  <div class="offer-head">
                    <span class="offer-icon">
                      <svg viewBox="0 0 24 24" aria-hidden="true" set:html={offerIcons[o.icon]} />
                    </span>
                    <div class="offer-title"><span class="offer-in">{o.title} <span class="offer-cn">// {o.cn}</span></span></div>
                  </div>
                  <div class="offer-desc"><span class="offer-in">{o.desc}</span></div>
                </div>
              ))}
            </div>
          </section>

          <section>
            <div class="section-title">Shipped Projects <span class="section-cn">// 参与作品</span></div>
            <div class="ship-strip">
              {shipped.map((g) => (
                <a class="ship" href={g.href} target="_blank" rel="noopener noreferrer">
                  <div class="ship-art" style={`background-image: url('${g.image}');`}></div>
                  <div class="ship-desc">
                    <div class="ship-title">{g.title}</div>
                    <div class="ship-engine">{g.engine}</div>
                    <div class="ship-note">{g.note}</div>
                  </div>
                </a>
              ))}
            </div>
          </section>

          <section>
            <div class="section-title">Repositories <span class="section-cn">// 展示品</span></div>
            <div class="cards">
              {projects.map((p) => {
                const emblem = p.icon || projectTypes[p.type].icon;
                const emblemVB = tileVB[emblem] || '0 0 24 24';
                return (
                <a class="card" href={p.href} target="_blank" rel="noopener noreferrer" title={p.blurb}>
                  <span class="card-corner tl"></span>
                  <span class="card-corner tr"></span>
                  <span class="card-corner bl"></span>
                  <span class="card-corner br"></span>
                  <span class="card-fx" aria-hidden="true">
                    <span class="card-vortex"></span>
                    <span class="card-burst"></span>
                  </span>
                  <div class="card-emblem">
                    <svg viewBox={emblemVB} fill="currentColor" aria-hidden="true" set:html={tileIcons[emblem]} />
                  </div>
                  <div class="card-name">{p.name}</div>
                  <div class="card-lang">{p.lang}</div>
                </a>
                );
              })}
            </div>
          </section>

          <section>
            <div class="section-title">Services <span class="section-cn">// 可提供服务</span></div>
            <div class="buckets">
              {skillBuckets.map((b) => (
                <div class="bucket">
                  <div class="bucket-title">{b.title}</div>
                  <ul class="bucket-list">
                    {b.items.map((s) => <li>{s}</li>)}
                  </ul>
                </div>
              ))}
            </div>
          </section>
          </div>
        </div>

        <aside class="col-side">
          <div class="panel">
            <div class="id-avatar">
              <div class="id-avatar-img" style={`background-image: url('${profile.card.avatar}');`} role="img" aria-label={`${profile.card.name} avatar`}></div>
            </div>
            <div class="id-name">{profile.card.name}</div>
            <div class="id-name-cn">{profile.card.nameCn}</div>
            <div class="id-foot">
              <span class="id-cta">{profile.card.pill}</span>
              <nav class="socials">
                {socials.map((s) => (
                  <a class="social" href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} title={s.label}>
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={icons[s.kind]} />
                  </a>
                ))}
              </nav>
            </div>
          </div>

          <div class="side-traits">
            <div class="side-head">Traits <span class="section-cn">// 特质</span></div>
            {traits.map((t) => (
              <div class="trait">
                <div class="trait-icon">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={tileIcons[t.icon]} />
                </div>
                <div class="trait-body">
                  <div class="trait-name">{t.name}</div>
                  <div class="trait-effect">{t.effect}</div>
                </div>
              </div>
            ))}
          </div>
        </aside>
      </div>

      <footer>
        <span>© {profile.card.name}</span>
        <a href="https://github.com/hchia93" target="_blank" rel="noopener noreferrer">Built with Astro · hosted on GitHub Pages</a>
      </footer>
    </main>

    <script>
      // cursor-tracked 3D tilt + float on skill cards
      const cards = document.querySelectorAll('.card');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduce) {
        cards.forEach((card) => {
          const el = card as HTMLElement;
          el.addEventListener('mousemove', (e) => {
            const r = el.getBoundingClientRect();
            const px = (e.clientX - r.left) / r.width - 0.5;
            const py = (e.clientY - r.top) / r.height - 0.5;
            el.style.transform = `translateY(-10px) rotateY(${px * 30}deg) rotateX(${-py * 30}deg) scale(1.15)`;
          });
          el.addEventListener('mouseleave', () => { el.style.transform = ''; });
        });
      }

      // selection: card lifts out, spins once, settles centred, then grows and dissolves into its link
      const backFace = '<span class="card-corner tl"></span><span class="card-corner tr"></span><span class="card-corner bl"></span><span class="card-corner br"></span><span class="card-fx"><span class="card-vortex"></span></span>';
      let busy = false;

      const clearSelection = () => {
        document.querySelectorAll('.card-select').forEach((n) => n.remove());
        cards.forEach((c) => { (c as HTMLElement).style.visibility = ''; });
        busy = false;
      };
      // bfcache can restore the page mid-animation when the user navigates back
      window.addEventListener('pageshow', (e) => { if (e.persisted) clearSelection(); });

      const playSelect = (el: HTMLAnchorElement) => {
        const rect = el.getBoundingClientRect();
        const w = el.offsetWidth;
        const h = el.offsetHeight;
        // layout size vs on-screen size differ under the large-screen zoom
        const z = rect.width / w;
        const vw = window.innerWidth;
        const vh = window.innerHeight;
        // phones: exactly the screen width. Desktop: about a third of the page width.
        const targetW = Math.min(vw <= 600 ? vw : vw / 3, vh * 0.9 * (w / h));
        const s = targetW / w;
        const at = (scale: number) => `translate(${(vw - w * scale) / 2}px, ${(vh - h * scale) / 2}px) scale(${scale})`;

        const shade = document.createElement('div');
        shade.className = 'card-select card-select-shade';
        const stage = document.createElement('div');
        stage.className = 'card-select card-select-stage';
        stage.style.width = `${w}px`;
        stage.style.height = `${h}px`;
        const flip = document.createElement('div');
        flip.className = 'card-select-flip';
        const front = el.cloneNode(true) as HTMLElement;
        front.removeAttribute('href');
        front.style.transform = 'none';
        front.classList.add('card-face');
        const back = document.createElement('div');
        back.className = 'card card-face card-back';
        back.innerHTML = backFace;
        flip.append(front, back);
        stage.append(flip);
        document.body.append(shade, stage);
        el.style.visibility = 'hidden';

        const from = `translate(${rect.left}px, ${rect.top}px) scale(${z})`;
        shade.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 500, fill: 'forwards' });
        flip.animate([{ transform: 'rotateY(0deg)' }, { transform: 'rotateY(360deg)' }], { duration: 950, easing: 'cubic-bezier(.45, 0, .2, 1)', fill: 'forwards' });
        stage.animate([{ transform: from }, { transform: at(s) }], { duration: 950, easing: 'cubic-bezier(.2, .7, .2, 1)', fill: 'forwards' })
          .finished
          .then(() => stage.animate([{ transform: at(s), opacity: 1 }, { transform: at(s * 1.5), opacity: 0 }], { duration: 550, delay: 150, easing: 'ease-in', fill: 'forwards' }).finished)
          .then(() => { window.location.href = el.href; });
      };

      cards.forEach((card) => {
        const el = card as HTMLAnchorElement;
        el.addEventListener('click', (e) => {
          // modified clicks keep the browser's own new-tab behaviour
          if (reduce || busy || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          e.preventDefault();
          busy = true;
          playSelect(el);
        });
      });
    </script>
  </body>
</html>
