---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name} · {profile.role}</title>
    <meta name="description" content={`${profile.name}, ${profile.role}.`} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='23' fill='%2306b6d4'/><text x='50' y='68' font-size='52' font-family='sans-serif' font-weight='700' fill='white' text-anchor='middle'>HC</text></svg>" />
  </head>
  <body>
    <main class="wrap">
      <div class="layout">
        <div class="col-main">
          <section class="cta">
            <div class="cta-line">{cta.line}</div>
            <a class="cta-btn" href={cta.href}>{cta.label}</a>
          </section>

          <header class="hero">
            <h1 class="hook">{hook.headline}</h1>
          </header>

          <p class="hook-sub">{hook.sub}</p>

          <section class="manifesto">
            {about.map((p) => <p>{p}</p>)}
          </section>

          <section>
            <div class="section-title">What I deliver</div>
            <div class="offers">
              {offers.map((o) => (
                <div class="offer">
                  <div class="offer-title">{o.title}</div>
                  <div class="offer-desc">{o.desc}</div>
                </div>
              ))}
            </div>
          </section>

          <section>
            <div class="section-title">Shipped on</div>
            <div class="ship-strip">
              {shipped.map((g) => (
                <div class="ship-card">
                  <div class="ship-title">{g.title}</div>
                  <span class="ship-engine">{g.engine}</span>
                  <div class="ship-note">{g.note}</div>
                </div>
              ))}
            </div>
          </section>

          <section>
            <div class="section-title">Work</div>
            {projectGroups.map((group) => (
              <div class="group" style={`--c: ${group.accent};`}>
                <div class="group-label">{group.title}</div>
                <div class="wall">
                  {group.items.map((p) => (
                    <a class="app" href={p.href} target="_blank" rel="noopener noreferrer" title={p.blurb}>
                      <div class="icon" style={`background: linear-gradient(135deg, ${p.from}, ${p.to});`}>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={tileIcons[p.icon]} />
                      </div>
                      <div class="name">{p.name}</div>
                      <div class="lang">{p.lang}</div>
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </section>

          <section>
            <div class="section-title">Services you can get from me</div>
            <div class="buckets">
              {skillBuckets.map((b) => (
                <div class="bucket">
                  <div class="bucket-title">{b.title}</div>
                  <ul class="bucket-list">
                    {b.items.map((s) => <li>{s}</li>)}
                  </ul>
                </div>
              ))}
            </div>
          </section>
        </div>

        <aside class="col-side">
          <div class="panel">
            <div class="id-pill">{profile.card.pill}</div>
            <div class="id-avatar">
              <div class="id-avatar-img" style={`background-image: url('${profile.card.avatar}');`} role="img" aria-label={`${profile.card.name} avatar`}></div>
            </div>
            <div class="id-foot">
              <div class="id-text">
                <div class="id-name">{profile.card.name}</div>
                {profile.card.tag && <div class="id-tag">{profile.card.tag}</div>}
              </div>
              <nav class="socials">
                {socials.map((s) => (
                  <a class="social" href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} title={s.label}>
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={icons[s.kind]} />
                  </a>
                ))}
              </nav>
            </div>
          </div>
          {sideCards.map((c) => (
            <div class="mini-card" style={`background: linear-gradient(120deg, ${c.from}, ${c.to});`}><span class="mini-label">{c.label}</span></div>
          ))}
        </aside>
      </div>

      <footer>
        <span>© {profile.card.name}</span>
        <a href="https://github.com/hchia93" target="_blank" rel="noopener noreferrer">Built with Astro · hosted on GitHub Pages</a>
      </footer>
    </main>
  </body>
</html>
