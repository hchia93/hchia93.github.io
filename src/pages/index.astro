  'bomb': '<g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><circle cx="11" cy="13" r="9"/><path d="M14.35 4.65L16.3 2.7a2.41 2.41 0 0 1 3.4 0l1.6 1.6a2.4 2.4 0 0 1 0 3.4l-1.95 1.95M22 2l-1.5 1.5"/></g>',
};

// Square viewBox per emblem, centred on the drawn shape and sized so every emblem has the
// same optical mass (geometric mean of the bbox ~78% of the box, longest side <= 95%).
const tileVB: Record<string, string> = {
  'anvil': '1.3 1.3 21.4 21.4',
  'hammer': '-42 -74 660 660',
  'scroll-unfurled': '-38.8 -44.2 598 598',
  'gamepad-2': '0.55 1.45 23 23',
  'graduation-cap': '-0.75 -0.75 25.5 25.5',
  'fossil': '-45.5 -45.5 603 603',
};

// Octocat outline reused by the embroidered card-back badge.
const ghPath = icons.github.match(/d="([^"]+)"/)![1];

// Embroidery thread colour per emblem, matching the real object.
const threadColor: Record<string, string> = {
  'anvil': '#7f8892',
  'hammer': '#9ea6b0',
  'scroll-unfurled': '#e2cd9c',
  'gamepad-2': '#0b0c0e',
  'graduation-cap': '#0b0c0e',
  'fossil': '#c39a62',
};

// Diagonal satin-stitch tile: thread colour plus a slightly lighter strand, like the card-back badge.
const satinTile = `data:image/svg+xml,${encodeURIComponent("<svg xmlns='http://www.w3.org/2000/svg' width='3' height='3'><path d='M-1 1L1-1M0 3L3 0M2 4L4 2' stroke='#fff' stroke-opacity='0.3' stroke-width='1.2'/></svg>")}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{profile.name} · {profile.role}</title>
    <meta name="description" content={`${profile.name}, ${profile.role}.`} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='23' fill='%2306b6d4'/><text x='50' y='68' font-size='52' font-family='sans-serif' font-weight='700' fill='white' text-anchor='middle'>HC</text></svg>" />
  </head>
  <body data-bug-jokes={JSON.stringify(bugJokes)} data-resolve-jokes={JSON.stringify(resolveJokes)}>
    <main class="wrap">
      <div class="layout">
        <div class="col-left">
          <section class="cta">
          </section>

          <div class="col-main">
          <header class="hero">
            <div class="hero-plate">
              <span class="id-crest hero-bug" aria-hidden="true"><CrestBug /></span>
              <h1 class="hook">{hook.headline}</h1>
            </div>
            <div class="hero-class">
              {hook.tags.map((t) => <span class="hero-tag">{t}</span>)}
            </div>
            <p class="hero-intro" set:html={hook.intro}></p>
            <ul class="hero-flavor">
              {about.map((p) => <li set:html={p}></li>)}
            </ul>
          </header>

          <section>
            <div class="section-title">Shipped Projects <span class="section-cn">· 参与作品</span></div>
            <div class="ship-strip">
              {shipped.map((g) => (
                <a class="ship" href={g.href} target="_blank" rel="noopener noreferrer">
                  <div class="ship-art" style={`background-image: url('${g.image}');`}></div>
                  <div class="ship-desc">
                    <div class="ship-title">{g.title}</div>
                    <div class="ship-engine">{g.engine}</div>
                    <div class="ship-note">{g.note}</div>
                  </div>
                </a>
              ))}
            </div>
          </section>

          <section>
            <div class="section-title">Roles <span class="section-cn">· 定位</span></div>
            <div class="modes">
              {gameModes.map((group) => (
                <div class="mode-group">{group.map((m) => <span class="hero-tag">{m}</span>)}</div>
              ))}
            </div>
            <div class="offers">
              {offers.map((o) => (
                <div class="offer">
                  <div class="offer-head">
                    <span class="offer-icon">
                      <svg viewBox="0 0 24 24" aria-hidden="true" set:html={offerIcons[o.icon]} />
                    </span>
                    <div class="offer-title"><span class="offer-in">{o.title} <span class="offer-cn">· {o.cn}</span></span></div>
                  </div>
                  <div class="offer-desc"><span class="offer-in">{o.desc}</span></div>
                </div>
              ))}
            </div>
          </section>

          <section>
            <svg width="0" height="0" style="position:absolute" aria-hidden="true">
              <filter id="embroider" x="-20%" y="-20%" width="140%" height="140%" color-interpolation-filters="sRGB">
                <feImage href={satinTile} x="0" y="0" width="3" height="3" result="tile" />
                <feTile in="tile" result="hi" />
                <feComposite in="hi" in2="SourceAlpha" operator="in" result="hiMask" />
                <feBlend in="hiMask" in2="SourceGraphic" mode="overlay" result="hiIn" />
                <feMorphology in="SourceAlpha" operator="erode" radius="0.5" result="core" />
                <feComposite in="SourceAlpha" in2="core" operator="out" result="seamMask" />
                <feFlood flood-color="#000" flood-opacity="0.5" />
                <feComposite in2="seamMask" operator="in" result="seam" />
                <feMerge>
                  <feMergeNode in="hiIn" /><feMergeNode in="seam" />
                </feMerge>
              </filter>
            </svg>
            <div class="section-title">Repositories <span class="section-cn">· 展示品</span></div>
            <div class="cards">
              {projects.map((p) => {
                const emblem = p.icon || projectTypes[p.type].icon;
                const emblemVB = tileVB[emblem] || '0 0 24 24';
                return (
                <a class="card" href={p.href} target="_blank" rel="noopener noreferrer" title={p.blurb}>
                  <span class="card-corner tl"></span>
                  <span class="card-corner tr"></span>
                  <span class="card-corner bl"></span>
                  <span class="card-corner br"></span>
                  <span class="card-fx" aria-hidden="true">
                    <span class="card-vortex"></span>
                    <span class="card-burst"></span>
                  </span>
                  <div class="card-emblem" style={`color: ${threadColor[emblem] ?? '#c9ced6'}`}>
                    <svg class="em-border" viewBox={emblemVB} aria-hidden="true" set:html={`<g class="em-edge">${tileIcons[emblem]}</g><g class="em-stitch">${tileIcons[emblem]}</g>`} />
                    <svg class="em-fill" viewBox={emblemVB} fill="currentColor" aria-hidden="true" set:html={tileIcons[emblem]} />
                  </div>
                  <div class="card-name">{p.name}</div>
                  <div class="card-lang">{p.lang}</div>
                </a>
                );
              })}
            </div>
          </section>

          <section>
            <div class="section-title">Services <span class="section-cn">· 可提供服务</span></div>
            <div class="buckets">
              {skillBuckets.map((b) => (
                <div class="bucket">
                  <div class="bucket-title">{b.title}</div>
                  <ul class="bucket-list">
                    {b.items.map((s) => <li>{s}</li>)}
                  </ul>
                </div>
              ))}
            </div>
          </section>
          </div>
        </div>

        <aside class="col-side">
          <div class="id-flip">
          <div class="id-flip-inner">
          <div class="id-front id-face">
          <div class="panel">
            <div class="id-avatar">
              <div class="id-avatar-img" style={`background-image: url('${profile.card.avatar}');`} role="img" aria-label={`${profile.card.name} avatar`}></div>
            </div>
            <div class="id-name">{profile.card.name}</div>
            <div class="id-name-cn">{profile.card.nameCn}</div>
            <div class="id-foot">
              <span class="id-cta">{profile.card.pill}</span>
              <nav class="socials">
                {socials.map((s) => (
                  <a class="social" href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label} title={s.label}>
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={icons[s.kind]} />
                  </a>
                ))}
              </nav>
            </div>
          </div>
          <CardFrame />
          </div>

          <CardBack class="id-face" githubPath={ghPath} />
          </div>
          </div>

          <div class="side-traits side-presets">
            <div class="side-head">Color Preset <span class="section-cn">· 颜色配置</span></div>
            <div class="theme-box">
              <div class="theme-swatches" role="radiogroup" aria-label="Card colour preset">
                {cardThemes.map((t, i) => (
                  <button class="theme-swatch" type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} title={t.name} data-theme={JSON.stringify(t)} style={`--sw-frame: ${t.frame}; --sw-face: ${t.face[1]};`}></button>
                ))}
              </div>
              <div class="theme-name" aria-live="polite">{cardThemes[0].name}</div>
            </div>
          </div>

          <div class="side-traits">
            <div class="side-head">Traits <span class="section-cn">· 特质</span></div>
            {traits.map((t) => (
              <div class="trait">
                <div class="trait-icon">
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={tileIcons[t.icon]} />
                </div>
                <div class="trait-body">
                  <div class="trait-name">{t.name}</div>
                  <div class="trait-effect">{t.effect}</div>
                </div>
              </div>
            ))}
          </div>
        </aside>
      </div>

      <footer>
        <span>© {profile.card.name}</span>
        <a href="https://github.com/hchia93" target="_blank" rel="noopener noreferrer">Built with Astro · hosted on GitHub Pages</a>
      </footer>
    </main>

    <script>
      // cursor-tracked 3D tilt + float on skill cards
      const cards = document.querySelectorAll('.card');
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      // Follow the cursor per frame. A CSS transition here would restart on every mousemove and trail behind.
      const tilt = (el: HTMLElement) => {
        const rest = { rx: 0, ry: 0, s: 1, ty: 0 };
        const cur = { ...rest };
        const tgt = { ...rest };
        let raf = 0;
        let last = 0;
        const frame = (t: number) => {
          const k = 1 - Math.pow(0.75, Math.max(t - last, 1) / 16.7);
          last = t;
          let moving = false;
          for (const key of ['rx', 'ry', 's', 'ty'] as const) {
            cur[key] += (tgt[key] - cur[key]) * k;
            if (Math.abs(tgt[key] - cur[key]) > 0.001) moving = true;
          }
          el.style.transform = `translateY(${cur.ty}px) rotateY(${cur.ry}deg) rotateX(${cur.rx}deg) scale(${cur.s})`;
          raf = moving ? requestAnimationFrame(frame) : 0;
        };
        const kick = () => {
          if (raf) return;
          last = performance.now();
          raf = requestAnimationFrame(frame);
        };
        el.addEventListener('mouseenter', () => {
          el.classList.add('tilting');
          tgt.s = 1.15;
          tgt.ty = -10;
          kick();
        });
        el.addEventListener('mousemove', (e) => {
          const r = el.getBoundingClientRect();
          tgt.ry = ((e.clientX - r.left) / r.width - 0.5) * 30;
          tgt.rx = -((e.clientY - r.top) / r.height - 0.5) * 30;
          kick();
        });
        el.addEventListener('mouseleave', () => {
          cancelAnimationFrame(raf);
          raf = 0;
          Object.assign(cur, rest);
          Object.assign(tgt, rest);
          // dropping .tilting restores the CSS transform transition, so the card eases back to rest
          el.classList.remove('tilting');
          el.style.transform = '';
        });
      };
      if (!reduce) cards.forEach((card) => tilt(card as HTMLElement));

      // selection: card lifts out, spins once, settles centred, then grows and dissolves into its link
      const backTemplate = document.getElementById('card-back-tpl') as HTMLTemplateElement;
      let busy = false;

      const clearSelection = () => {
        document.querySelectorAll('.card-select').forEach((n) => n.remove());
        cards.forEach((c) => { (c as HTMLElement).style.visibility = ''; });
        busy = false;
      };
      // bfcache can restore the page mid-animation when the user navigates back
      window.addEventListener('pageshow', (e) => { if (e.persisted) clearSelection(); });

      const playSelect = (el: HTMLAnchorElement) => {
        const rect = el.getBoundingClientRect();
        const w = el.offsetWidth;
        const h = el.offsetHeight;
        // layout size vs on-screen size differ under the large-screen zoom
        const z = rect.width / w;
        const vw = window.innerWidth;
        const vh = window.innerHeight;
        // phones: exactly the screen width. Desktop: about a third of the page width.
        const targetW = Math.min(vw <= 600 ? vw : vw / 3, vh * 0.9 * (w / h));
        const s = targetW / w;
        // Render at the final size and animate the scale down to it. Scaling a small raster up looks
        // soft for the whole flight and snaps sharp at the end.
        const bigW = w * s;
        const bigH = h * s;
        const at = (scale: number) => `translate(${(vw - bigW * scale) / 2}px, ${(vh - bigH * scale) / 2}px) scale(${scale})`;

        const shade = document.createElement('div');
        shade.className = 'card-select card-select-shade';
        const stage = document.createElement('div');
        stage.className = 'card-select card-select-stage';
        stage.style.width = `${bigW}px`;
        stage.style.height = `${bigH}px`;
        const zoomer = document.createElement('div');
        zoomer.className = 'card-select-zoom';
        zoomer.style.width = `${w}px`;
        zoomer.style.height = `${h}px`;
        zoomer.style.zoom = String(s);
        const flip = document.createElement('div');
        flip.className = 'card-select-flip';
        const front = el.cloneNode(true) as HTMLElement;
        front.removeAttribute('href');
        front.style.transform = 'none';
        front.classList.add('card-face');
        // The card-back design is laid out at the identity card's 250px width. Lay it out there and zoom it down to this card.
        const back = backTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement;
        back.classList.add('card-face', 'card-back');
        back.style.width = '250px';
        back.style.height = `${(h * 250) / w}px`;
        back.style.zoom = String(w / 250);
        flip.append(front, back);
        zoomer.append(flip);
        stage.append(zoomer);
        document.body.append(shade, stage);
        el.style.visibility = 'hidden';

        const from = `translate(${rect.left}px, ${rect.top}px) scale(${z / s})`;
        // enlarge -> turn to the back -> dissolve
        const turn = (a: number, b: number, delay: number) => flip.animate([{ transform: `rotateY(${a}deg)` }, { transform: `rotateY(${b}deg)` }], { duration: 800, delay, easing: 'cubic-bezier(.45, 0, .25, 1)', fill: 'forwards' }).finished;
        shade.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 500, fill: 'forwards' });
        stage.animate([{ transform: from }, { transform: at(1) }], { duration: 650, easing: 'cubic-bezier(.2, .7, .2, 1)', fill: 'forwards' })
          .finished
          .then(() => turn(0, 180, 100))
          .then(() => stage.animate([{ transform: at(1), opacity: 1 }, { transform: at(1.5), opacity: 0 }], { duration: 550, delay: 150, easing: 'ease-in', fill: 'forwards' }).finished)
          .then(() => { window.location.href = el.href; });
      };

      // click feedback, layered: a diamond flash with sparks, plus the crest bug fluttering away
      const clickFx = (x: number, y: number) => {
        const fx = document.createElement('div');
        fx.className = 'click-fx';
        fx.style.transform = `translate(${x}px, ${y}px)`;
        const ring = document.createElement('span');
        ring.className = 'click-fx-ring';
        fx.append(ring);
        ring.animate([{ transform: 'rotate(45deg) scale(0.2)', opacity: 1 }, { transform: 'rotate(45deg) scale(1.5)', opacity: 0 }], { duration: 420, easing: 'cubic-bezier(.2, .7, .3, 1)', fill: 'forwards' });
        for (let i = 0; i < 8; i++) {
          const spark = document.createElement('span');
          spark.className = 'click-fx-spark';
          const a = i * 45 + 22.5;
          spark.animate([{ transform: `rotate(${a}deg) translateY(-6px) scaleY(1)`, opacity: 1 }, { transform: `rotate(${a}deg) translateY(-24px) scaleY(0.3)`, opacity: 0 }], { duration: 450, easing: 'cubic-bezier(.2, .7, .3, 1)', fill: 'forwards' });
          fx.append(spark);
        }
        document.body.append(fx);
        window.setTimeout(() => fx.remove(), 500);
      };

      const crest = backTemplate.content.querySelector('.id-crest');
      const clickBug = (x: number, y: number) => {
        if (!crest) return;
        const bug = document.createElement('div');
        bug.className = 'click-bug';
        bug.append(crest.cloneNode(true));
        document.body.append(bug);

        // mostly upward, with a sideways weave while it flies
        const heading = (-90 + (Math.random() * 100 - 50)) * (Math.PI / 180);
        const dist = 170 + Math.random() * 90;
        const dx = Math.cos(heading);
        const dy = Math.sin(heading);
        const facing = (heading * 180) / Math.PI + 90;
        const frames = [0, 0.25, 0.5, 0.75, 1].map((t) => {
          const along = dist * (1 - (1 - t) * (1 - t));
          const weave = Math.sin(t * Math.PI * 3) * 12;
          const px = x + dx * along - dy * weave;
          const py = y + dy * along + dx * weave;
          return { transform: `translate(${px}px, ${py}px) rotate(${facing + weave * 1.5}deg) scale(${t === 0 ? 0.3 : 0.7})`, opacity: t < 0.7 ? 1 : 1 - (t - 0.7) / 0.3 };
        });
        bug.animate(frames, { duration: 1300, easing: 'linear', fill: 'forwards' }).finished.then(() => bug.remove());
        bug.querySelectorAll('.crest-wings').forEach((w) => w.animate([{ transform: 'scaleX(1)' }, { transform: 'scaleX(0.3)' }], { duration: 70, iterations: 18, direction: 'alternate' }));
      };

      // ambient: now and then a bug drifts across the top banner, entering and leaving past its clipped edges
      const banner = document.querySelector('.cta') as HTMLElement | null;
      const bannerFlyby = () => {
        const r = banner?.getBoundingClientRect();
        const onScreen = r && r.bottom > 0 && r.top < window.innerHeight;
        if (!crest || !banner || document.hidden || !onScreen) return;
        const bug = document.createElement('div');
        bug.className = 'click-bug banner-bug';
        bug.append(crest.cloneNode(true));
        banner.append(bug);

        const w = banner.clientWidth;
        const h = banner.clientHeight;
        const ltr = Math.random() < 0.5;
        // rare golden bug: bigger, slower, and always trailing glitter
        const golden = Math.random() < 0.05;
        if (golden) bug.classList.add('golden');
        const size = golden ? 1.25 : 0.45 + Math.random() * 0.2;
        const speed = golden ? 130 : 160 + Math.random() * 100;
        const baseY = h * (0.25 + Math.random() * 0.5);
        const drift = (Math.random() * 2 - 1) * h * 0.2;
        const frames = Array.from({ length: 13 }, (_, i) => {
          const t = i / 12;
          const along = -50 + (w + 100) * t;
          const px = ltr ? along : w - along;
          const bob = Math.sin(t * Math.PI * 5) * 14;
          const py = baseY + drift * t + bob;
          const pitch = Math.cos(t * Math.PI * 5) * 14;
          return { transform: `translate(${px}px, ${py}px) rotate(${(ltr ? 90 : -90) + (ltr ? pitch : -pitch)}deg) scale(${size})` };
        });
        const duration = ((w + 100) / speed) * 1000;
        const flaps = [...bug.querySelectorAll('.crest-wings')].map((wing) => wing.animate([{ transform: 'scaleX(1)' }, { transform: 'scaleX(0.3)' }], { duration: 70, iterations: Infinity, direction: 'alternate' }));
        const glitter = golden ? window.setInterval(() => {
          const m = new DOMMatrix(getComputedStyle(bug).transform);
          spawnGlitter(m.m41 + (Math.random() * 2 - 1) * 22, m.m42 + (Math.random() * 2 - 1) * 18, 0, 18);
        }, 45) : 0;
        const flight = bug.animate(frames, { duration, easing: 'linear', fill: 'forwards' });
        const stop = () => {
          window.clearInterval(glitter);
          flaps.forEach((f) => f.cancel());
          bannerBugs.delete(bug);
        };
        bannerBugs.set(bug, { flight, stop, golden });
        flight.finished.then(() => { stop(); bug.remove(); }, () => {});
      };

      const bannerBugs = new Map<HTMLElement, { flight: Animation; stop: () => void; golden: boolean }>();
      const spawnGlitter = (x: number, y: number, dx: number, dy: number) => {
        if (!banner) return;
        const g = document.createElement('span');
        g.className = 'glitter';
        banner.append(g);
        const gs = 0.5 + Math.random() * 0.8;
        g.animate([
          { transform: `translate(${x}px, ${y}px) scale(0) rotate(0deg)`, opacity: 1 },
          { transform: `translate(${x + dx * 0.35}px, ${y + dy * 0.35}px) scale(${gs}) rotate(45deg)`, opacity: 1, offset: 0.35 },
          { transform: `translate(${x + dx}px, ${y + dy}px) scale(0) rotate(90deg)`, opacity: 0 },
        ], { duration: 700, easing: 'ease-out', fill: 'forwards' }).finished.then(() => g.remove());
      };

      // banner clicks squash a bug under the pointer instead of spawning one
      const squashAt = (x: number, y: number) => {
        for (const [bug, state] of bannerBugs) {
          const r = bug.querySelector('.id-crest')!.getBoundingClientRect();
          const reach = Math.max(r.width, r.height) * 0.6 + 8;
          if (Math.hypot(x - (r.left + r.width / 2), y - (r.top + r.height / 2)) > reach) continue;
          const pose = getComputedStyle(bug).transform;
          state.flight.cancel();
          state.stop();
          bug.style.transform = pose;
          bug.animate([
            { transform: `${pose} scale(1)`, opacity: 1 },
            { transform: `${pose} rotate(25deg) scale(1.35, 0.25)`, opacity: 0 },
          ], { duration: 280, easing: 'ease-in', fill: 'forwards' }).finished.then(() => bug.remove());
          if (state.golden) {
            const m = new DOMMatrix(pose);
            for (let i = 0; i < 14; i++) {
              const a = (i / 14) * Math.PI * 2;
              const d = 40 + Math.random() * 30;
              spawnGlitter(m.m41, m.m42, Math.cos(a) * d, Math.sin(a) * d);
            }
          }
          return true;
        }
        return false;
      };

      // sometimes a small swarm of 2-3 instead of a lone bug, staggered so they don't overlap
      const scheduleFlyby = (min: number, max: number) => window.setTimeout(() => {
        const count = Math.random() < 0.4 ? 2 + Math.floor(Math.random() * 2) : 1;
        for (let i = 0; i < count; i++) window.setTimeout(bannerFlyby, i * (300 + Math.random() * 700));
        scheduleFlyby(2000, 5000);
      }, min + Math.random() * (max - min));
      if (!reduce) scheduleFlyby(800, 1800);

      // Pseudo-random distribution (Dota style): the chance grows by C on every miss and resets on a hit.
      // C = 0.04092 averages out to a 17% hit rate without long droughts or streaks.
      const bugJokes: string[] = JSON.parse(document.body.dataset.bugJokes ?? '[]');
      const resolveJokes: string[] = JSON.parse(document.body.dataset.resolveJokes ?? '[]');
      const jokeC = 0.04092;
      let jokeMisses = 0;
      const rollJoke = () => {
        jokeMisses += 1;
        if (Math.random() >= jokeMisses * jokeC) return false;
        jokeMisses = 0;
        return true;
      };
      const clickJoke = (x: number, y: number, words: string[], variant?: string) => {
        const pop = document.createElement('div');
        pop.className = variant ? `click-joke ${variant}` : 'click-joke';
        pop.textContent = words[Math.floor(Math.random() * words.length)];
        document.body.append(pop);
        const tilt = Math.random() * 16 - 8;
        pop.animate([
          { transform: `translate(${x}px, ${y}px) translate(-50%, -50%) rotate(${tilt}deg) scale(0.4)`, opacity: 0 },
          { transform: `translate(${x}px, ${y - 34}px) translate(-50%, -50%) rotate(${tilt}deg) scale(1.15)`, opacity: 1, offset: 0.18 },
          { transform: `translate(${x}px, ${y - 48}px) translate(-50%, -50%) rotate(${tilt}deg) scale(1)`, opacity: 1, offset: 0.7 },
          { transform: `translate(${x}px, ${y - 70}px) translate(-50%, -50%) rotate(${tilt}deg) scale(1)`, opacity: 0 },
        ], { duration: 1200, easing: 'ease-out', fill: 'forwards' }).finished.then(() => pop.remove());
      };

      if (!reduce) {
        document.addEventListener('pointerdown', (e) => {
          if (e.button !== 0) return;
          clickFx(e.clientX, e.clientY);
          if (banner?.contains(e.target as Node)) {
            if (squashAt(e.clientX, e.clientY) && resolveJokes.length) clickJoke(e.clientX, e.clientY, resolveJokes, 'resolve');
            return;
          }
          clickBug(e.clientX, e.clientY);
          if (bugJokes.length && rollJoke()) clickJoke(e.clientX, e.clientY, bugJokes);
        });
      }

      // identity card: the front only shows while the page sits at the top. Scrolling away turns it to its back.
      const idFlip = document.querySelector('.id-flip');
      const showBack = (back: boolean) => {
        idFlip?.classList.toggle('is-back', back);
        document.querySelector('.panel')?.toggleAttribute('inert', back);
        document.querySelector('.id-back')?.toggleAttribute('inert', !back);
      };
      let atTop = window.scrollY <= 40;
      showBack(!atTop);

      // colour presets: swap the card palette variables page-wide, so whichever face shows (now or after a flip) is recoloured
      const themeVars = (t: { front: string[]; frame: string; face: string[]; ray: string; moon: string; line: string; motto: string }) => ({
        '--cb-frame': t.frame, '--cb-face-1': t.face[0], '--cb-face-2': t.face[1], '--cb-face-3': t.face[2],
        '--cb-ray': t.ray, '--cb-moon': t.moon, '--cb-line': t.line, '--cb-motto': t.motto,
        '--cf-1': t.front[0], '--cf-2': t.front[1], '--cf-3': t.front[2],
      });
      document.querySelectorAll<HTMLButtonElement>('.theme-swatch').forEach((sw) => {
        sw.addEventListener('click', () => {
          const theme = JSON.parse(sw.dataset.theme!);
          Object.entries(themeVars(theme)).forEach(([k, v]) => document.documentElement.style.setProperty(k, v));
          const label = document.querySelector('.theme-name');
          if (label) label.textContent = theme.name;
          document.querySelectorAll('.theme-swatch').forEach((o) => o.setAttribute('aria-checked', String(o === sw)));
        });
      });
      window.addEventListener('scroll', () => {
        const nowTop = window.scrollY <= 40;
        if (nowTop === atTop) return;
        atTop = nowTop;
        showBack(!nowTop);
      }, { passive: true });

      cards.forEach((card) => {
        const el = card as HTMLAnchorElement;
        el.addEventListener('click', (e) => {
          // modified clicks keep the browser's own new-tab behaviour
          if (reduce || busy || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          e.preventDefault();
          busy = true;
          playSelect(el);
        });
      });
    </script>
    <template id="card-back-tpl"><CardBack githubPath={ghPath} /></template>
  </body>
</html>
